# --- Telegram (required) ---
# Get it from @BotFather on Telegram.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Public base URL used to build short links (required locally) ---
# Local dev:  http://localhost:8080
# Production: https://yourdomain.com
# On Render this can be omitted - RENDER_EXTERNAL_URL is used automatically.
BASE_URL=http://localhost:8080

# --- Database (optional) ---
# Local dev / Render persistent disk: sqlite+aiosqlite:///./bot.db
# Postgres (Render, Neon, ...):      postgresql://user:pass@host/db
#   (scheme and sslmode are converted for asyncpg automatically)
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# --- Short code length 6-8 (optional) ---
SHORT_CODE_LENGTH=6

# --- Redirect web server bind (optional) ---
WEB_HOST=0.0.0.0
PORT=8080

# --- Telegram delivery mode (optional) ---
# Auto-enabled on Render (RENDER_EXTERNAL_URL); set to true elsewhere only
# if BASE_URL is a public HTTPS URL that reaches this server.
# USE_WEBHOOK=true
# Optional; a valid token is derived from BOT_TOKEN when omitted.
# WEBHOOK_SECRET=
# WEBHOOK_PATH=/telegram/webhook

# --- Keep-alive (optional) ---
# Auto-enabled on Render (RENDER_EXTERNAL_URL); self-pings /healthz on a
# timer so free web services don't spin down after 15 idle minutes.
# KEEP_ALIVE=true
# KEEP_ALIVE_INTERVAL=600

# --- Logging (optional): DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
